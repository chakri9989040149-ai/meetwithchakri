# ========================================================
# CHAKRI'S MEET CLIENT — ENVIRONMENT VARIABLES
# ========================================================

# Backend Socket.io URL (Required in production e.g. https://chakris-meet-api.onrender.com)
# In local dev: Leave empty to automatically use current origin / localhost:5000
VITE_SOCKET_URL=

# Backend REST API base URL (e.g. https://chakris-meet-api.onrender.com/api)
VITE_API_URL=

# Public Application URL (e.g. https://chakris-meet.vercel.app or Cloudflare tunnel URL)
# If provided, meeting invite links will use this public URL instead of localhost
VITE_PUBLIC_URL=

# Optional WebRTC TURN Server (for restrictive firewalls & symmetric NAT)
VITE_TURN_SERVER_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
