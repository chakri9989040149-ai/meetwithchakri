# ========================================================
# CHAKRI'S MEET CLIENT — ENVIRONMENT VARIABLES
# ========================================================

# Backend Server Base URL (e.g. https://chakris-meet-api.onrender.com or deployed server)
# Used for Socket.io signaling and REST API endpoints
VITE_BACKEND_URL=

# Backend Socket.io URL (Optional override, defaults to VITE_BACKEND_URL)
VITE_SOCKET_URL=

# Backend REST API base URL (Optional override, defaults to VITE_BACKEND_URL/api)
VITE_API_URL=

# Public Application URL (e.g. https://chakris-meet.vercel.app or Cloudflare tunnel URL)
# If provided, meeting invite links will use this public URL instead of localhost
VITE_PUBLIC_URL=

# Optional WebRTC TURN Server (for restrictive firewalls & symmetric NAT)
VITE_TURN_SERVER_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
