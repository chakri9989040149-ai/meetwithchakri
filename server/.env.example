# ========================================================
# CHAKRI'S MEET SERVER — ENVIRONMENT VARIABLES
# ========================================================

# Server Port
PORT=5000

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Node Environment ('development' or 'production')
NODE_ENV=development

# PostgreSQL Database Connection URL (Optional for local test; fallback is in-memory)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chakris_meet

# WebRTC TURN Server (Optional for restrictive NAT/firewalls in production)
# Example: turn:numb.viagenie.ca:3478 or turn:relay.metered.ca:443
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Room capacity limit
MAX_PARTICIPANTS=25
